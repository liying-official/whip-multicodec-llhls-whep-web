# ================= 公网 Web / TLS 1.3 =================
# 必填：直播网页域名，不要写 https://，例如 live.example.com
PUBLIC_DOMAIN=

# 公网访问 HTTPS 端口。服务器内的 Caddy 始终监听 TCP/UDP 443；如果路由器
# 使用非标准公网端口映射到 443，这里必须填写实际公网端口。TCP 和 UDP 必须
# 映射同一端口，
# 否则 HTTP/3 的 Alt-Svc 通告无法与 HTTP/1.1 / HTTP/2 URL 保持一致。
PUBLIC_HTTPS_PORT=443

# 必填：公网可信 TLS 证书和私钥（PEM）。
# 以下为项目目录内的通用相对默认路径；也可改为管理员维护的路径。
TLS_CERT=certs/fullchain.pem
TLS_KEY=certs/privkey.pem

# ================= OBS WHIP / WebRTC =================
# 可选：指定 OBS 要连接的本机私网 IPv4。留空时启动程序自动识别已启用的
# RFC1918 网卡，优先使用默认路由对应的私网地址。
WHIP_IP=

# 旧版兼容项，请保持为空。发布白名单在每次启动时强制生成为：
# WHIP_IP 所属网卡的真实局域网网段 + WHIP_IP/32 本机地址。手工值会被忽略。
INGEST_ALLOW_CIDRS=

# 必填：公网 WebRTC ICE 使用的 DNS 域名，例如 live.example.com。
# 公网 IPv4 可以动态变化，只要该域名的 A 记录由 DDNS 持续更新即可。
# 为避免 WebRTC 再收到 IPv6 ICE candidate，PUBLIC_HOST 必须只有 A 记录、不能有 AAAA；如主站需要 IPv6，请使用单独的 A-only WebRTC 子域名。
# 不要写 http:// / https://，不要带端口，也不要直接填写 IPv4/IPv6 地址。
# 启动时若留空、格式错误或当前无法解析出 IPv4 A 记录，将拒绝启动。
PUBLIC_HOST=
