 type unitRemuxer func(format.Format, unit.Payload) unit.Payload
 
+func av1PayloadWithExactSize(obu []byte, offset int) ([]byte, bool) {
+	if offset >= len(obu) {
+		return nil, false
+	}
+
+	var size mcav1.LEB128
+	n, err := size.Unmarshal(obu[offset:])
+	if err != nil {
+		return nil, false
+	}
+
+	payloadStart := offset + n
+	if int(size) != (len(obu) - payloadStart) {
+		return nil, false
+	}
+
+	return obu[payloadStart:], true
+}
+
+func normalizeAV1OBU(obu []byte) ([]byte, bool) {
+	if len(obu) == 0 {
+		return nil, false
+	}
+
+	header := obu[0]
+	if (header & 0b10000001) != 0 {
+		return nil, false
+	}
+
+	typ := (header >> 3) & 0b1111
+	hasExtension := (header & 0b00000100) != 0
+	hasSize := (header & 0b00000010) != 0
+	offset := 1
+
+	if hasExtension {
+		if len(obu) < 2 {
+			return nil, false
+		}
+
+		extension := obu[1]
+		if (extension & 0b111) != 0 {
+			return nil, false
+		}
+
+		temporalID := extension >> 5
+		spatialID := (extension >> 3) & 0b11
+
+		// CMAF carries a single decodable layer. Drop enhancement layers and
+		// remove the extension header from the base layer.
+		if temporalID != 0 || spatialID != 0 {
+			return nil, false
+		}
+
+		offset++
+	}
+
+	var data []byte
+	if hasSize {
+		var ok bool
+		data, ok = av1PayloadWithExactSize(obu, offset)
+		if !ok {
+			return nil, false
+		}
+	} else {
+		data = obu[offset:]
+	}
+
+	// libdatachannel <= v0.24.3 drops the OBU base header when an extension
+	// header is present, but leaves the internal LEB128 size field in place.
+	// A base-layer extension byte is zero, therefore it reaches us as a
+	// reserved type-0 OBU. OBS AOM emits OBU_FRAME in this path.
+	if typ == 0 && !hasExtension && !hasSize {
+		var ok bool
+		data, ok = av1PayloadWithExactSize(obu, 1)
+		if !ok {
+			return nil, false
+		}
+		typ = 6 // OBU_FRAME
+	}
+
+	// Ignore reserved OBU types instead of terminating every HLS muxer reader.
+	if typ == 0 || (typ >= 8 && typ <= 14) {
+		return nil, false
+	}
+
+	ret := make([]byte, 1+len(data))
+	ret[0] = typ << 3
+	copy(ret[1:], data)
+	return ret, true
+}
+
+func av1OBUIsKeyFrame(obu []byte, reducedStillPictureHeader bool) bool {
+	if len(obu) < 2 {
+		return false
+	}
+
+	typ := (obu[0] >> 3) & 0b1111
+	if typ != 3 && typ != 6 { // OBU_FRAME_HEADER, OBU_FRAME
+		return false
+	}
+
+	if reducedStillPictureHeader {
+		return true
+	}
+
+	// uncompressed_header(): show_existing_frame, then frame_type.
+	if (obu[1] & 0b10000000) != 0 {
+		return false
+	}
+
+	frameType := (obu[1] >> 5) & 0b11
+	return frameType == 0 // KEY_FRAME
+}
+
+func newUnitRemuxerAV1() unitRemuxer {
+	var sequenceHeader []byte
+	reducedStillPictureHeader := false
+
+	return func(_ format.Format, payload unit.Payload) unit.Payload {
+		tu := payload.(unit.PayloadAV1)
+		filtered := make([][]byte, 0, len(tu)+1)
+		hasSequenceHeader := false
+		hasKeyFrame := false
+
+		for _, obu := range tu {
+			normalized, ok := normalizeAV1OBU(obu)
+			if !ok {
+				continue
+			}
+
+			typ := (normalized[0] >> 3) & 0b1111
+			if typ == 1 { // OBU_SEQUENCE_HEADER
+				hasSequenceHeader = true
+
+				var parsed mcav1.SequenceHeader
+				if parsed.Unmarshal(normalized) == nil {
+					sequenceHeader = append(sequenceHeader[:0], normalized...)
+					reducedStillPictureHeader = parsed.ReducedStillPictureHeader
+				}
+			}
+
+			if av1OBUIsKeyFrame(normalized, reducedStillPictureHeader) {
+				hasKeyFrame = true
+			}
+
+			filtered = append(filtered, normalized)
+		}
+
+		// OBS AOM can emit a sequence header only at stream startup and does
+		// not repeat it when a later key frame is requested through PLI.
+		// gohlslib uses the sequence header as the AV1 random-access marker,
+		// therefore restore the cached header only before actual KEY_FRAMEs.
+		if hasKeyFrame && !hasSequenceHeader && len(sequenceHeader) != 0 {
+			withSequenceHeader := make([][]byte, 0, len(filtered)+1)
+			withSequenceHeader = append(withSequenceHeader, sequenceHeader)
+			filtered = append(withSequenceHeader, filtered...)
+		}
+
+		return unit.PayloadAV1(filtered)
+	}
+}
+
+func unitRemuxerAV1(forma format.Format, payload unit.Payload) unit.Payload {
+	return newUnitRemuxerAV1()(forma, payload)
+}
