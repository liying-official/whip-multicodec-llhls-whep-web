@@ -0,0 +1,101 @@
+package stream
+
+import (
+	"testing"
+
+	"github.com/bluenviron/gortsplib/v5/pkg/format"
+	"github.com/bluenviron/mediamtx/internal/unit"
+	"github.com/stretchr/testify/require"
+)
+
+func TestUnitRemuxerAV1(t *testing.T) {
+	for _, ca := range []struct {
+		name string
+		in   unit.PayloadAV1
+		out  unit.PayloadAV1
+	}{
+		{
+			name: "normal without size",
+			in:   unit.PayloadAV1{{0x30, 0x11, 0x22}},
+			out:  unit.PayloadAV1{{0x30, 0x11, 0x22}},
+		},
+		{
+			name: "normal with size",
+			in:   unit.PayloadAV1{{0x32, 0x02, 0x11, 0x22}},
+			out:  unit.PayloadAV1{{0x30, 0x11, 0x22}},
+		},
+		{
+			name: "sequence header with size",
+			in:   unit.PayloadAV1{{0x0A, 0x02, 0x11, 0x22}},
+			out:  unit.PayloadAV1{{0x08, 0x11, 0x22}},
+		},
+		{
+			name: "proper base layer extension",
+			in:   unit.PayloadAV1{{0x34, 0x00, 0x11, 0x22}},
+			out:  unit.PayloadAV1{{0x30, 0x11, 0x22}},
+		},
+		{
+			name: "proper base layer extension with size",
+			in:   unit.PayloadAV1{{0x36, 0x00, 0x02, 0x11, 0x22}},
+			out:  unit.PayloadAV1{{0x30, 0x11, 0x22}},
+		},
+		{
+			name: "proper enhancement layer extension",
+			in:   unit.PayloadAV1{{0x34, 0x20, 0x11, 0x22}},
+			out:  unit.PayloadAV1{},
+		},
+		{
+			name: "libdatachannel missing base header",
+			in:   unit.PayloadAV1{{0x00, 0x02, 0x11, 0x22}},
+			out:  unit.PayloadAV1{{0x30, 0x11, 0x22}},
+		},
+		{
+			name: "invalid internal size",
+			in:   unit.PayloadAV1{{0x32, 0x03, 0x11, 0x22}},
+			out:  unit.PayloadAV1{},
+		},
+		{
+			name: "empty and reserved",
+			in:   unit.PayloadAV1{{}, {0x40, 0x11}},
+			out:  unit.PayloadAV1{},
+		},
+	} {
+		t.Run(ca.name, func(t *testing.T) {
+			require.Equal(t, ca.out, unitRemuxerAV1(
+				&format.AV1{PayloadTyp: 96},
+				ca.in))
+		})
+	}
+}
+
+func TestUnitRemuxerAV1SequenceHeaderRestore(t *testing.T) {
+	remux := newUnitRemuxerAV1()
+	forma := &format.AV1{PayloadTyp: 96}
+	sequenceWithSize := []byte{
+		0x0a, 0x0b, 0x00, 0x00, 0x00, 0x42, 0xab,
+		0xbf, 0xc3, 0x71, 0xab, 0xe6, 0x01,
+	}
+	sequence := []byte{
+		0x08, 0x00, 0x00, 0x00, 0x42, 0xab,
+		0xbf, 0xc3, 0x71, 0xab, 0xe6, 0x01,
+	}
+
+	require.Equal(t, unit.PayloadAV1{sequence}, remux(
+		forma,
+		unit.PayloadAV1{sequenceWithSize}))
+
+	keyFrame := []byte{0x30, 0x10, 0x11}
+	require.Equal(t, unit.PayloadAV1{sequence, keyFrame}, remux(
+		forma,
+		unit.PayloadAV1{keyFrame}))
+
+	interFrame := []byte{0x30, 0x30, 0x22}
+	require.Equal(t, unit.PayloadAV1{interFrame}, remux(
+		forma,
+		unit.PayloadAV1{interFrame}))
+
+	showExistingFrame := []byte{0x30, 0x80, 0x33}
+	require.Equal(t, unit.PayloadAV1{showExistingFrame}, remux(
+		forma,
+		unit.PayloadAV1{showExistingFrame}))
+}
