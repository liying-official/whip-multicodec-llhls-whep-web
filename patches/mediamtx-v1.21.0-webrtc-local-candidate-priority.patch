+// hostCandidatePriorities returns the ICE priorities assigned to the host
+// candidates of a given address.
+//
+// Addresses inside the local network are preferred over public ones. The
+// public address of a server that is reachable both locally and through a NAT
+// gateway is otherwise an equally ranked choice, and clients that nominate it
+// force their own media through that gateway - which is a slow path and, on
+// consumer gateways, a lossy one.
+func hostCandidatePriorities(ip string) (uint32, uint32) {
+	const (
+		localUDPPriority  = 2130706431
+		localTCPPriority  = 1671430143
+		remotePriorityGap = 1 << 16
+	)
+
+	addr := net.ParseIP(ip)
+	if addr != nil && (addr.IsPrivate() || addr.IsLoopback() || addr.IsLinkLocalUnicast()) {
+		return localUDPPriority, localTCPPriority
+	}
+
+	return localUDPPriority - remotePriorityGap, localTCPPriority - remotePriorityGap
+}
